# ==========================================
# Environments & Secrets (CRITICAL)
# ==========================================
.env
.env.*
*.env
!.env.example

# ==========================================
# Python Virtual Environments
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Python Bytecode & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Testing & Type Checking Cache
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# Database & Vector Store Data
# ==========================================
chroma_db/
*.sqlite3
*.db
*.db-journal

# ==========================================
# Uploaded & Temporary Documents
# ==========================================
# Ignore uploaded files but keep the uploads directory
uploads/*
!uploads/.gitkeep

# ==========================================
# Logs & Process Files
# ==========================================
*.log
logs/
*.pid

# ==========================================
# IDE & Code Editor Files
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ==========================================
# OS Generated Files (Windows & macOS)
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
